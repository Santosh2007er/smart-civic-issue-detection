<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="roadSurf" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="50%" stop-color="#334155"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
  </defs>
  <!-- Background Road -->
  <rect width="600" height="400" fill="url(#roadSurf)"/>
  
  <!-- Faded center lane dividing line -->
  <line x1="0" y1="200" x2="600" y2="200" stroke="#fef08a" stroke-width="12" stroke-dasharray="40,30" opacity="0.6"/>
  
  <!-- Severe alligator cracking / road disintegration -->
  <g stroke="#0f172a" stroke-width="4" fill="none">
    <path d="M 50 150 L 120 180 L 180 140 L 250 190 L 320 160 L 400 220 L 480 170 L 550 210"/>
    <path d="M 120 180 L 110 240 L 170 270 L 230 230 L 300 290 L 390 270 L 450 320"/>
    <path d="M 180 140 L 210 90 L 280 110 L 320 160"/>
    <path d="M 250 190 L 260 250 L 330 260 L 360 210"/>
    <path d="M 390 270 L 420 330 L 500 310 L 520 260"/>
    <path d="M 80 220 L 50 280 L 110 310"/>
  </g>
  
  <!-- Loose gravel and broken asphalt chunks -->
  <g fill="#0f172a">
    <circle cx="150" cy="220" r="8"/>
    <circle cx="210" cy="180" r="12"/>
    <polygon points="280,210 295,230 275,235"/>
    <polygon points="340,190 360,200 350,220"/>
    <circle cx="410" cy="240" r="10"/>
    <polygon points="460,280 480,270 475,295"/>
  </g>

  <!-- AI Detection Box Overlay -->
  <rect x="70" y="80" width="460" height="250" fill="none" stroke="#f97316" stroke-width="3" stroke-dasharray="6,4"/>
  <rect x="70" y="50" width="220" height="30" fill="#f97316" rx="4"/>
  <text x="80" y="70" fill="#ffffff" font-family="Arial, sans-serif" font-weight="bold" font-size="14">DAMAGED ROAD: 95.2%</text>
</svg>
